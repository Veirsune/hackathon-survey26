# Local settings: copy to .env and fill OPENAI_API_KEY locally, never in chat.
# Competition rules explicitly list this Kimi Coding Plan endpoint/model.
# Check event-specific use with the organizers if your account is not covered.
# Cloud runs use the platform's injected OPENAI_BASE_URL / OPENAI_API_KEY.
# The official packer excludes .env; configure the key on the Participate page.
OPENAI_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_MODEL=kimi-for-coding
OPENAI_API_KEY=

# Bounded model calls per card; all settings below are optional.
AGENT_LLM_ENABLED=1
AGENT_LLM_TOTAL_SECONDS=120
AGENT_LLM_CALL_SECONDS=30
AGENT_LLM_MAX_CALLS=6
AGENT_LLM_REASONING_EFFORT=low

# Logs already include structured model_advice / model_summary records on stderr.
# Optional extra trace path should be OUTSIDE the agent directory.
AGENT_TRACE_PATH=
