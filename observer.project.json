{
  "schema_version": "observer-project-v1",
  "protocol": "jsonl-v4",
  "image": "python:3.12-slim",
  "build": [
    [
      "python3",
      "-m",
      "pip",
      "install",
      "--target",
      ".vendor",
      "-r",
      "requirements.txt"
    ]
  ],
  "run": [
    "python3",
    "-u",
    "agent.py"
  ],
  "working_directory": ".",
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "AGENT_LLM_REASONING_EFFORT": "low",
    "AGENT_LLM_ENABLED": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "PYTHONPATH": ".vendor",
    "AGENT_LLM_MAX_CALLS": "8",
    "AGENT_LLM_TOTAL_SECONDS": "120",
    "AGENT_LLM_CALL_SECONDS": "30",
    "AGENT_LLM_MAX_TOKENS": "2200"
  }
}
